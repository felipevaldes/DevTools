# ~/.config/ghostty/config

# --- Font ---
font-family = "Source Code Pro"
font-size = 12

# --- Theme ---
theme = One Double Dark

term = xterm-256color

# --- Window ---
window-padding-x = 12
window-padding-y = 10


# --- Cursor ---
cursor-style = bar

# --- Scrollback ---
scrollback-limit = 10000

# --- Tab bar ---
# macos-tab-bar-style = native

# --- Keybinds ---
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+n=new_window
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Splitting
keybind = ctrl+shift+r=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+l=new_split:left
keybind = ctrl+shift+u=new_split:up

# Navigate between splits (arrows)
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:top
keybind = ctrl+shift+down=goto_split:bottom

# Close current split
keybind = ctrl+shift+w=close_surface

# Equalize all splits
keybind = ctrl+shift+equal=equalize_splits
